{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "Address": {
      "type": "object",
      "description": "A physical address",
      "required": ["street", "city"],
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "zipCode": {
          "type": "string"
        }
      }
    },
    "Person": {
      "type": "object",
      "description": "A person with an address",
      "required": ["name", "address"],
      "properties": {
        "name": {
          "type": "string"
        },
        "address": {
          "$ref": "#/definitions/Address"
        }
      }
    }
  }
}
